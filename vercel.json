{
  "functions": {
    "api/generate-post-session-intelligence.js": {
      "maxDuration": 300
    },
    "api/generate-pre-session-brief.js": {
      "maxDuration": 180
    },
    "api/generate-cluster-proposals.js": {
      "maxDuration": 300
    },
    "api/generate-coach-dna.js": {
      "maxDuration": 120
    },
    "api/aggregate-client-pattern-map.js": {
      "maxDuration": 120
    },
    "api/generate-coaching-strategy.js": {
      "maxDuration": 120
    },
    "api/generate-intervention-plan.js": {
      "maxDuration": 300
    },
    "api/revise-intervention-plan.js": {
      "maxDuration": 300
    },
    "api/regenerate-intervention-plan-from-scratch.js": {
      "maxDuration": 300
    },
    "api/generate-session-plan.js": {
      "maxDuration": 120
    },
    "api/generate-approach-lab.js": {
      "maxDuration": 300
    },
    "api/generate-effectiveness-map.js": {
      "maxDuration": 120
    },
    "api/cron-interventions.js": {
      "maxDuration": 300
    },
    "api/map-intake-submit.js": {
      "maxDuration": 180
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "cleanUrls": true,
  "crons": [
    { "path": "/api/process-reminders", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/reset-usage-counters", "schedule": "0 6 * * *" }
  ],
  "rewrites": [
    { "source": "/coach/:slug", "destination": "/coach-profile?slug=:slug" },
    { "source": "/intervention-plan", "destination": "/intervention-plan-panel" },
    { "source": "/coach-mirror", "destination": "/coach-mirror-panel" },
    { "source": "/pattern-map", "destination": "/pattern-map-panel" },
    { "source": "/coaching-strategy", "destination": "/coaching-strategy-panel" },
    { "source": "/article", "destination": "/api/article-render" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}
